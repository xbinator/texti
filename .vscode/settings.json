{
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.fixAll.stylelint": "explicit"
  },
  "eslint.validate": ["javascript", "javascriptreact", "vue", "typescript"],
  "stylelint.enable": true,
  "stylelint.validate": ["css", "less", "vue"],
  "volar.inlayHints.eventArgumentInInlineHandlers": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    ".gitignore": ".gitattributes",
    ".eslintrc.cjs": ".eslintignore, .prettierignore, .prettierrc, prettier.config.cjs, commitlint.config.js, .editorconfig",
    ".stylelintrc.cjs": ".stylelintignore",
    "README.md": "*.md",
    "tsconfig.json": "tsconfig.*.json, jsconfig.json",
    "package.json": "pnpm-lock.yaml, .npmrc, .nvmrc, pnpm-workspace.yaml, electron-builder.yml, logo.svg"
  }
}
