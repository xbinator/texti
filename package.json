{
  "name": "tibis",
  "private": true,
  "version": "0.2.11",
  "description": "A local-first Markdown desktop editor for writing and AI workflows.",
  "author": "Tibis contributors",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "main": "dist-electron/electron/main/index.mjs",
  "scripts": {
    "serve": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev": "concurrently -k \"pnpm run serve\" \"pnpm run electron:watch-main\" \"pnpm run electron:run\"",
    "electron:dev": "pnpm run dev",
    "electron:build-main": "node scripts/clean-dist-electron.mjs && tsc -p electron/tsconfig.json",
    "electron:watch-main": "tsc -p electron/tsconfig.json -w",
    "electron:run": "wait-on dist-electron/electron/main/index.mjs && node --watch-path=dist-electron --watch-preserve-output ./node_modules/electron/cli.js .",
    "electron:build": "pnpm run build && pnpm run electron:build-main && electron-builder --publish never",
    "shell:pty:smoke": "pnpm electron:build-main && node ./node_modules/electron/cli.js . --shell-pty-smoke",
    "shell:pty:packaged-smoke": "node ./scripts/shell/pty-packaged-smoke.mjs",
    "postinstall": "electron-rebuild --only better-sqlite3,node-pty",
    "test": "cross-env HOST=127.0.0.1 vitest run && pnpm run test:database",
    "test:database": "cross-env ELECTRON_RUN_AS_NODE=1 HOST=127.0.0.1 electron node_modules/vitest/vitest.mjs run test/electron/main/modules/database/session-metadata-migration.test.ts test/electron/main/modules/database/agent-task-migration.test.ts test/electron/main/modules/chat/agents/store.test.ts test/electron/main/modules/chat/agents/budget.test.ts test/electron/main/modules/chat/agents/delegation-foundation.test.ts test/electron/main/modules/chat/agents/read-runtime.test.ts test/electron/main/modules/chat/agents/startup-recovery.test.ts test/electron/main/modules/chat/agents/write-runtime.test.ts",
    "lint": "eslint src --ext .vue,.ts,.tsx,.js,.jsx,.mts --fix",
    "lint:style": "stylelint 'src/**/*.{vue,less,css}' --fix"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "better-sqlite3",
      "node-pty",
      "sharp"
    ],
    "peerDependencyRules": {
      "ignoreMissing": [
        "tree-sitter"
      ]
    }
  },
  "dependencies": {
    "@ai-sdk/alibaba": "^2.0.23",
    "@ai-sdk/anthropic": "^4.0.28",
    "@ai-sdk/deepseek": "^3.0.20",
    "@ai-sdk/gateway": "4.0.39",
    "@ai-sdk/google": "^4.0.32",
    "@ai-sdk/openai": "^4.0.28",
    "@ai-sdk/openai-compatible": "3.0.21",
    "@ai-sdk/provider": "4.0.5",
    "@ai-sdk/provider-utils": "5.0.19",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "^1.9.1",
    "@standard-schema/spec": "^1.1.0",
    "@xterm/headless": "6.0.0",
    "ai": "^7.0.50",
    "atomically": "2.1.1",
    "better-sqlite3": "^12.10.0",
    "chokidar": "^5.0.0",
    "dayjs": "^1.11.21",
    "electron-log": "^5.4.4",
    "electron-store": "^10.1.0",
    "eventsource-parser": "^3.1.0",
    "jszip": "^3.10.1",
    "lodash-es": "^4.18.1",
    "nanoid": "^5.1.11",
    "node-pty": "1.1.0",
    "picomatch": "4.0.5",
    "sharp": "^0.34.5",
    "tinycolor2": "^1.6.0",
    "tree-sitter-bash": "^0.25.1",
    "tree-sitter-powershell": "^0.26.4",
    "web-tree-sitter": "^0.26.11",
    "xstate": "^5.32.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^1.8.1",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^2.1.5",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^1.1.0",
    "@codemirror/commands": "^6.10.4",
